@model IEnumerable<AuditEntry>
@{ViewData["Title"]="Audit log";}
<h1>Audit log</h1><div class="table-wrap"><table><thead><tr><th>UTC</th><th>Actor</th><th>Action</th><th>Record</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.CreatedAtUtc.ToString("u")</td><td>@x.Actor</td><td>@x.Action</td><td>@x.Record</td></tr>}</tbody></table></div>
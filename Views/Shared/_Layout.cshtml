<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - Inventory</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body><header><div class="container nav"><a asp-controller="Dashboard" asp-action="Index" class="brand">Inventory MVC</a>
@if(User.Identity?.IsAuthenticated==true){<nav><a asp-controller="Products" asp-action="Index">Products</a> · <a asp-controller="MasterData" asp-action="Index">Master data</a> · <a asp-controller="Warehouses" asp-action="Index">Warehouses</a> · <a asp-controller="Stock" asp-action="Index">Ledger</a> · <a asp-controller="Purchases" asp-action="Index">Purchases</a> · <a asp-controller="Reports" asp-action="Index">Reports</a></nav><form asp-controller="Account" asp-action="Logout" method="post"><button type="submit">Sign out</button></form>}
</div></header><main class="container">@RenderBody()</main><footer class="container">Inventory MVC</footer>@await RenderSectionAsync("Scripts",required:false)</body></html>